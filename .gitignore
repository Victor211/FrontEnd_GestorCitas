# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
# .env and .env.local variants are machine-specific and never committed.
# .env.example, .env.development and .env.production are intentionally
# tracked: they only ever contain public, non-secret configuration.
.env
.env.*
!.env.example
!.env.development
!.env.production

