# Configuración pública de producción — versionada a propósito.
# No contiene secretos.
#
# IMPORTANTE: VITE_API_BASE_URL usa un placeholder. Reemplazalo por
# el dominio real del backend antes de correr "npm run build" para
# producción (ver docs/deployment.md, paso 1).

VITE_APP_NAME=Appointment Manager
VITE_APP_VERSION=1.0.0

VITE_API_BASE_URL=https://api.example.com

VITE_DEFAULT_TIMEZONE=America/Asuncion
VITE_ENABLE_DEBUG=false
