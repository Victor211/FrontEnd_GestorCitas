# ============================================
# Appointment Manager - Frontend
# ============================================
# Copiá este archivo a .env.local (o .env) y ajustá los valores
# para tu entorno. Ninguna variable de este archivo es secreta:
# todo lo que empieza con VITE_ queda embebido en el bundle y es
# visible para cualquiera que abra el navegador.

# Aplicación
# Nombre visible de la app (uso interno/futuro, no crítico).
VITE_APP_NAME=Appointment Manager
# Versión mostrada con fines informativos (uso interno/futuro).
VITE_APP_VERSION=1.0.0

# Backend
# URL base del backend real (sin "/" final). Es la única variable
# obligatoria: si falta, el frontend no arranca.
VITE_API_BASE_URL=http://localhost:8080

# Desarrollo
# Puerto del servidor de desarrollo de Vite (npm run dev).
VITE_DEV_PORT=5173

# Configuración
# Zona horaria usada solo como fallback visual/configurativo.
# No reemplaza timeZone: "local" en el calendario ni las
# conversiones UTC/local ya existentes en Appointments/Schedules.
VITE_DEFAULT_TIMEZONE=America/Asuncion
# Habilita logs de depuración controlados (no imprime tokens,
# headers de Authorization ni datos personales).
VITE_ENABLE_DEBUG=false
