# Configuración pública de desarrollo — versionada a propósito.
# No contiene secretos. Ver docs/environment.md para el detalle
# de cada variable. Se puede sobrescribir por máquina con
# .env.local o .env.development.local (ambos ignorados por Git).

VITE_APP_NAME=Appointment Manager
VITE_APP_VERSION=1.0.0

VITE_API_BASE_URL=http://localhost:8080
VITE_DEV_PORT=5173

VITE_DEFAULT_TIMEZONE=America/Asuncion
VITE_ENABLE_DEBUG=true
